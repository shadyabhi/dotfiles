globalias() {
   if [[ $LBUFFER =~ '(^| )[A-Z0-9]+$' ]]; then
     zle _expand_alias
     zle expand-word
   fi
   zle self-insert
}

zle -N globalias

bindkey " " globalias
bindkey "^ " magic-space           # control-space to bypass completion
bindkey -M isearch " " magic-space # normal space during searches

# vim is really nvim
alias vim="nvim"
alias v="nvim"

alias p3="python3"

# Open markdown
alias md="open -a MarkEdit" 

# chezmoi is too long to type
alias cm="chezmoi"

# Global
alias -g CCR="claude --resume"
alias -g G="| grep "
