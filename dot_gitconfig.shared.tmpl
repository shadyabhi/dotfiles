[user]
    name = Abhijeet Rastogi
    email = {{ .email }}

[sendemail]
    smtpServer = smtp.gmail.com
    smtpServerPort = 587
    smtpEncryption = tls
    smtpUser = {{ .email }}

[credential]
    helper = cache --timeout=7200

[color]
    ui = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    whitespace = red reverse
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = yellow
    changed = green
    untracked = cyan

[diff]
    tool = cdiff

[alias]
    # Status & info
    st = status -s --untracked-files=no
    s = log -sP  # search commits
    la = "!git config -l | grep alias | cut -c 7-"  # list aliases
    ign = ls-files -o -i --exclude-standard  # ignored files

    # Staging
    a = "!f() { git add \"$@\" && git status; }; f"
    ai = "!sel=$(git ls-files --modified --others --exclude-standard | fzf --multi --preview 'd=$(git diff --color=always -- {} 2>/dev/null); [ -n \"$d\" ] && echo \"$d\" || cat {}') && echo \"$sel\" | xargs -r git add && echo \"$sel\" && git status"  # interactive file select via fzf
    aif = "!sel=$(git ls-files --modified --others --exclude-standard | grep -v '/$' | fzf --multi --preview 'd=$(git diff --color=always -- {} 2>/dev/null); [ -n \"$d\" ] && echo \"$d\" || cat {}') && echo \"$sel\" | xargs -r git add && echo \"$sel\" && git status"  # interactive file select, files only
    aid = "!sel=$({ git diff --name-only; git ls-files --others --exclude-standard; } | sed 's|[^/]*$||' | sed 's|/$||' | sort -u | grep . | fzf --multi --preview 'git status --short -- {}') && echo \"$sel\" | xargs -r git add && echo \"$sel\" && git status"  # interactive directory select

    # Commit
    c = commit --verbose
    ca = commit -a --verbose
    ce = commit --amend

    # Diff
    d = diff
    dc = diff --cached
    dm = diff --stat main..HEAD -p
    dmc = diff --diff-filter=U  # unmerged/conflicted files

    # Branch & checkout
    br = branch
    co = checkout
   
    branchsync = "!f() { git fetch origin && git merge origin/$1; }; f"
    deletelocalbranch = branch -D
    deleteremotebranch = push origin --delete

    pushf = "!f() { branch=$(git symbolic-ref --short HEAD); if [ \"$branch\" = main ] || [ \"$branch\" = master ]; then echo \"ERROR: force push to '$branch' is not allowed\"; exit 1; fi; git push --force-with-lease \"$@\"; }; f"  # force push, blocked on main/master

    # Rebase
    rb = !git rebase -i $(git merge-base HEAD origin/main)
    rc = rebase --continue

    # Log
    lol = log --pretty=format:"%C(yellow)%h\\ %Cblue%cd%Cred%d\\ %Creset%s%Cred\\ [%an]" --decorate
    lolp = log --pretty=format:"%C(yellow)%h\\ %Cblue%cd%Cred%d\\ %Creset%s%Cred\\ [%cn]" --decorate -p  # with patch
    lola = log --pretty=format:"%C(yellow)%h\\ %Cblue%cd%Cred%d\\ %Creset%s%Cred\\ [%cn]" --decorate --numstat --date=relative --author  # by author
    loll = log --pretty=format:"%C(yellow)%h\\ %Cblue%cd%Cred%d\\ %Creset%s%Cred\\ [%cn]" --decorate --numstat  # with line counts
    lolr = log --pretty=format:"%C(yellow)%h\\ %Cblue%cd%Cred%d\\ %Creset%s%Cred\\ [%cn]" --decorate --numstat --date=relative  # relative dates
    lolg = log --graph --decorate --pretty=oneline --abbrev-commit --all  # graph view
    news = log --pretty=format:"%C(yellow)%h\\ %Cblue%cd%Cred%d\\ %Creset%s%Cred\\ [%cn]" --decorate --numstat --date=relative -p HEAD@{1}..HEAD@{0}  # changes since last pull

    # Search
    searchBranchWithCommit = "!f() { pattern=\"$1\"; commit=\"$2\"; count=\"${3:-1}\"; git fetch --quiet; found=0; for branch in $(git branch -r -l \"$pattern\" --sort=-creatordate); do if git merge-base --is-ancestor \"$commit\" \"$branch\" 2>/dev/null; then echo \"$branch\"; found=$((found + 1)); if [ \"$found\" -ge \"$count\" ]; then break; fi; fi; done; if [ \"$found\" -eq 0 ]; then echo \"No matching branch found.\"; fi; }; f"
    searchCommitWithPattern = log -sP  # search commits


[push]
    default = current

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    required = true
    process = git-lfs filter-process

[core]
    editor = nvim
    pager = diffnav
    excludesfile = ~/.gitignore

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection
    side-by-side = true

[merge]
    conflictStyle = zdiff3

[pull]
    rebase = true

[init]
    defaultBranch = main
