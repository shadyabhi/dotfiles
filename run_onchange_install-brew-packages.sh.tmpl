#!/bin/bash
# brew_packages.lst hash: {{ include "private_dot_config/dotfiles/brew_packages.lst" | sha256sum }}
# brew_taps.lst hash: {{ include "private_dot_config/dotfiles/brew_taps.lst" | sha256sum }}
set -euo pipefail

if ! command -v brew &>/dev/null; then
    echo "brew not found, skipping package installation"
    exit 0
fi

# Taps
while IFS= read -r tap || [[ -n "$tap" ]]; do
    tap=$(echo "$tap" | xargs)
    [[ -z "$tap" || "$tap" == \#* ]] && continue
    echo "Tapping $tap..."
    brew tap "$tap"
done < {{ joinPath .chezmoi.homeDir ".config/dotfiles/brew_taps.lst" | quote }}

# Packages
while IFS= read -r package || [[ -n "$package" ]]; do
    package=$(echo "$package" | xargs)
    [[ -z "$package" || "$package" == \#* ]] && continue
    if ! brew list --formula "$package" &>/dev/null; then
        echo "Installing $package..."
        brew install "$package"
    fi
done < {{ joinPath .chezmoi.homeDir ".config/dotfiles/brew_packages.lst" | quote }}
