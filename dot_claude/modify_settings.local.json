{{- /* chezmoi:modify-template */ -}}
{{- $data := fromJson .chezmoi.stdin -}}
{{- $data = $data | setValueAtPath "model" "claude-opus-4-6" -}}
{{- $data = $data | setValueAtPath "outputStyle" "default" -}}
{{- $data = $data | setValueAtPath "prefersReducedMotion" false -}}
{{- $data = $data | setValueAtPath "statusLine" (dict "type" "command" "command" "python3 ~/.claude/statusline-command.py") -}}
{{- $perms := list
  "Bash(find)"
  "Bash(make run:*)"
  "Bash(du:*)"
  "Bash(cd:*)"
  "Bash(npx vite:*)"
  "Bash(npm install:*)"
  "Bash(npx vitx)"
-}}
{{- if not (hasKey $data "permissions") -}}
{{-   $data = $data | setValueAtPath "permissions" (dict "allow" list) -}}
{{- end -}}
{{- if not (hasKey $data.permissions "allow") -}}
{{-   $_ := set $data.permissions "allow" list -}}
{{- end -}}
{{- range $perms -}}
{{-   if not (has . $data.permissions.allow) -}}
{{-     $_ := set $data.permissions "allow" (append $data.permissions.allow .) -}}
{{-   end -}}
{{- end -}}
{{ $data | toPrettyJson }}
