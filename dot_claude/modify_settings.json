{{- /* chezmoi:modify-template */ -}}
{{- $current := "{}" -}}
{{- if and (hasKey .chezmoi "stdin") .chezmoi.stdin -}}
{{-   $current = .chezmoi.stdin -}}
{{- end -}}
{{- $data := fromJson $current -}}
{{- if eq .chezmoi.config.data.device_type "work" -}}
{{-   $data = $data | setValueAtPath "model" "opus[1m]" -}}
{{- else -}}
{{-   $data = $data | setValueAtPath "model" "opus" -}}
{{- end -}}
{{- $data = $data | setValueAtPath "outputStyle" "Concise" -}}
{{- $data = $data | setValueAtPath "prefersReducedMotion" false -}}
{{- $data = $data | setValueAtPath "cleanupPeriodDays" 99999 -}}
{{- $data = $data | setValueAtPath "includeCoAuthoredBy" false -}}
{{- $data = $data | setValueAtPath "CLAUDE_CODE_NO_FLICKER" 1 -}}
{{- $data = $data | setValueAtPath "fullscreen" true -}}
{{- /* --- Hooks ---------------------------------------------------------- */ -}}
{{- $notificationHook := dict "type" "command" "command" "bash ~/.claude/hooks/notification.sh" -}}
{{- $workmuxWaitingHook := dict "type" "command" "command" "workmux set-window-status waiting" -}}
{{- $notificationGroup := list
      (dict "matcher" "" "hooks" (list $notificationHook))
      (dict "matcher" "permission_prompt|elicitation_dialog" "hooks" (list $workmuxWaitingHook))
-}}

{{- $permAuditHook := dict "type" "command" "command" "python3 ~/.claude/hooks/permission-audit.py" "timeout" 5 -}}
{{- $preToolUseGroup := list (dict "matcher" "" "hooks" (list $permAuditHook)) -}}

{{- $workmuxWorkingHook := dict "type" "command" "command" "workmux set-window-status working" -}}
{{- $postToolUseGroup := list (dict "hooks" (list $workmuxWorkingHook)) -}}

{{- $workmuxRegisterHook := dict "type" "command" "command" "workmux register-agent" -}}
{{- $sessionStartGroup := list (dict "matcher" "startup|resume|clear|fork" "hooks" (list $workmuxRegisterHook)) -}}

{{- $stopHook := dict "type" "command" "command" "bash ~/.claude/hooks/stop.sh" -}}
{{- $workmuxDoneHook := dict "type" "command" "command" "workmux set-window-status done" -}}
{{- $stopGroup := list
      (dict "matcher" "" "hooks" (list $stopHook))
      (dict "hooks" (list $workmuxDoneHook))
-}}

{{- $userPromptSubmitGroup := list (dict "hooks" (list $workmuxWorkingHook)) -}}

{{- $hooks := dict
      "Notification"     $notificationGroup
      "PostToolUse"      $postToolUseGroup
      "PreToolUse"       $preToolUseGroup
      "SessionStart"     $sessionStartGroup
      "Stop"             $stopGroup
      "UserPromptSubmit" $userPromptSubmitGroup
-}}
{{- $data = $data | setValueAtPath "hooks" $hooks -}}
{{- $data = $data | setValueAtPath "statusLine" (dict "type" "command" "command" "python3 ~/.claude/statusline-command.py") -}}
{{- $permsRaw := include ".chezmoitemplates/claude_allow_permissions" -}}
{{- $perms := list -}}
{{- range splitList "\n" $permsRaw -}}
{{-   $trimmed := trim . -}}
{{-   if ne $trimmed "" -}}
{{-     $perms = append $perms $trimmed -}}
{{-   end -}}
{{- end -}}
{{- if not (hasKey $data "permissions") -}}
{{-   $data = $data | setValueAtPath "permissions" (dict "allow" list) -}}
{{- end -}}
{{- if not (hasKey $data.permissions "allow") -}}
{{-   $_ := set $data.permissions "allow" list -}}
{{- end -}}
{{- $_ := set $data.permissions "defaultMode" "plan" -}}
{{- range $perms -}}
{{-   if not (has . $data.permissions.allow) -}}
{{-     $_ := set $data.permissions "allow" (append $data.permissions.allow .) -}}
{{-   end -}}
{{- end -}}
{{- /* Ensure official plugins are enabled */ -}}
{{- $officialPlugins := list
  "feature-dev@claude-plugins-official"
  "gopls-lsp@claude-plugins-official"
  "playground@claude-plugins-official"
  "swift-lsp@claude-plugins-official"
-}}
{{- if not (hasKey $data "enabledPlugins") -}}
{{-   $_ := set $data "enabledPlugins" dict -}}
{{- end -}}
{{- range $plugin := $officialPlugins -}}
{{-   if not (hasKey $data.enabledPlugins $plugin) -}}
{{-     $_ := set $data.enabledPlugins $plugin true -}}
{{-   end -}}
{{- end -}}
{{ $data | toPrettyJson | trimSuffix "\n" -}}
