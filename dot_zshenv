. "$HOME/.cargo/env"
# zerobrew
export ZEROBREW_DIR=/Users/shadyabhi/.zerobrew
export ZEROBREW_BIN=/Users/shadyabhi/.local/bin
export ZEROBREW_ROOT=/opt/zerobrew
export ZEROBREW_PREFIX=/opt/zerobrew/prefix
export PKG_CONFIG_PATH="/opt/zerobrew/prefix/lib/pkgconfig:${PKG_CONFIG_PATH:-}"
_zb_path_append() {
    local argpath="$1"
    case ":${PATH}:" in
        *:"$argpath":*) ;;
        *) export PATH="$argpath:$PATH" ;;
    esac;
}
_zb_path_append $ZEROBREW_BIN
_zb_path_append $ZEROBREW_PREFIX/bin

# zerobrew
export PATH="/opt/zerobrew/prefix/bin:$PATH"
