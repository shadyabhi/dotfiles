{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

# .chezmoidata/packages.yaml hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}

set -euo pipefail

if ! command -v brew &>/dev/null; then
    echo "brew not found, skipping package installation"
    exit 0
fi

if git rev-parse HEAD@{1} &>/dev/null; then
    echo "Changes in packages.yaml since last pull/commit:"
    git log HEAD@{1}.. --stat -- .chezmoidata/packages.yaml || true
fi

BREWFILE=$(cat <<EOF
# Taps
{{ range .packages.taps -}}
tap {{ . | quote }}
{{ end -}}

# Brews
{{ range .packages.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ if eq .device_type "personal" -}}
{{ range .packages.personal_brews -}}
brew {{ . | quote }}
{{ end -}}
{{ end -}}
{{ if eq .device_type "work" -}}
{{ range .packages.work_brews -}}
brew {{ . | quote }}
{{ end -}}
{{ end -}}

# Casks
{{ range .packages.casks -}}
{{ if not (has . $.meta.enable_sudo) -}}
cask {{ . | quote }}
{{ end -}}
{{ end -}}
{{ if eq .device_type "personal" -}}
{{ range .packages.personal_casks -}}
cask {{ . | quote }}
{{ end -}}
{{ end -}}
{{ if eq .device_type "work" -}}
{{ range .packages.work_casks -}}
cask {{ . | quote }}
{{ end -}}
{{ end -}}
EOF
)

echo "Running brew bundle..."
# Create a temporary file to capture output while still showing it
BUNDLE_OUTPUT=$(mktemp)
if ! echo "$BREWFILE" | brew bundle install --file=/dev/stdin --verbose 2>&1 | tee "$BUNDLE_OUTPUT"; then
    echo "brew bundle failed, identifying issues..."
    
    # 1. Identify packages that brew bundle check says are missing
    MISSING_PACKAGES=$(echo "$BREWFILE" | brew bundle check --file=/dev/stdin --verbose | grep "The following .* are not installed:" -A 1000 | grep -v "The following .* are not installed:" || true)
    
    # 2. Identify packages that failed during the install process (e.g., link errors)
    FAILED_INSTALLS=$(grep "Installing .* has failed!" "$BUNDLE_OUTPUT" | sed -E 's/Installing (.*) has failed!/\1/' || true)
    
    COMBINED_PACKAGES=$(echo -e "${MISSING_PACKAGES}\n${FAILED_INSTALLS}" | grep -v '^$' | sort -u || true)
    
    if [[ -n "$COMBINED_PACKAGES" ]]; then
        echo "Attempting to fix/install packages individually..."
        while IFS= read -r package; do
            [[ -z "$package" ]] && continue
            package=$(echo "$package" | xargs) # trim whitespace
            echo "Processing: $package"
            
            # Check if it's a formula, cask, or tap
            line=$(grep -E "^(brew|cask|tap) \"$package\"" <<< "$BREWFILE" || grep -E "^(brew|cask|tap) '$package'" <<< "$BREWFILE" || true)
            
            if [[ -n "$line" ]]; then
                echo "Attempting reinstall for $package..."
                if [[ "$line" == brew* ]]; then
                    brew uninstall --force "$package" || true
                    brew install "$package" --overwrite || echo "FAILED: brew install $package"
                elif [[ "$line" == cask* ]]; then
                    brew uninstall --cask --force "$package" || true
                    brew install --cask "$package" || echo "FAILED: brew install $package"
                else
                    # Fallback to brew bundle for the single line
                    if ! echo "$line" | brew bundle --file=/dev/stdin; then
                        echo "FAILED: $line"
                    fi
                fi
            else
                echo "Could not find Brewfile line for $package, trying 'brew install $package'"
                brew install "$package" || echo "FAILED: brew install $package"
            fi
        done <<< "$COMBINED_PACKAGES"
    fi
fi
rm -f "$BUNDLE_OUTPUT"

{{ if .meta.enable_sudo -}}
# Install casks that require sudo separately, allowing failure
{{ range .packages.casks -}}
{{ if has . $.meta.enable_sudo -}}
echo "Installing sudo-required cask: {{ . }}"
brew install --cask {{ . | quote }} || echo "Skipped {{ . }} (requires sudo)"
{{ end -}}
{{ end -}}
{{ end -}}

{{ end -}}
