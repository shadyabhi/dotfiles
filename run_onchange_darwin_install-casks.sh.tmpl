{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

set -euo pipefail

if ! command -v brew &>/dev/null; then
    echo "brew not found, skipping casks"
    exit 0
fi

BREWFILE=$(cat <<EOF
{{ range .packages.casks -}}
{{ if not (has . $.meta.enable_sudo) -}}
cask {{ . | quote }}
{{ end -}}
{{ end -}}
{{ if eq .device_type "personal" -}}
{{ range .packages.personal_casks -}}
cask {{ . | quote }}
{{ end -}}
{{ end -}}
{{ if eq .device_type "work" -}}
{{ range .packages.work_casks -}}
cask {{ . | quote }}
{{ end -}}
{{ end -}}
EOF
)

if ! echo "$BREWFILE" | brew bundle --file=/dev/stdin; then
    echo "brew bundle failed, identifying missing packages..."
    MISSING_PACKAGES=$(echo "$BREWFILE" | brew bundle check --file=/dev/stdin --verbose | grep "The following .* are not installed:" -A 1000 | grep -v "The following .* are not installed:" || true)
    
    if [[ -n "$MISSING_PACKAGES" ]]; then
        echo "Attempting to install missing packages individually..."
        while IFS= read -r package; do
            [[ -z "$package" ]] && continue
            package=$(echo "$package" | xargs) # trim whitespace
            echo "Installing: $package"
            line=$(grep -E "^(brew|cask|tap) \"$package\"" <<< "$BREWFILE" || grep -E "^(brew|cask|tap) '$package'" <<< "$BREWFILE" || true)
            if [[ -n "$line" ]]; then
                if ! echo "$line" | brew bundle --file=/dev/stdin; then
                    echo "FAILED: $line"
                fi
            else
                echo "Could not find Brewfile line for $package, trying 'brew install --cask $package'"
                brew install --cask "$package" || echo "FAILED: brew install --cask $package"
            fi
        done <<< "$MISSING_PACKAGES"
    fi
fi

{{ if .meta.enable_sudo -}}
# Install casks that require sudo separately, allowing failure
{{ range .packages.casks -}}
{{ if has . $.meta.enable_sudo -}}
brew install --cask {{ . | quote }} || echo "Skipped {{ . }} (requires sudo)"
{{ end -}}
{{ end -}}
{{ end -}}
{{ end -}}
