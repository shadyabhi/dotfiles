{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

set -euo pipefail

if ! command -v brew &>/dev/null; then
    echo "brew not found, skipping brews"
    exit 0
fi

BREWFILE=$(cat <<EOF
{{ range .packages.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ if eq .device_type "personal" -}}
{{ range .packages.personal_brews -}}
brew {{ . | quote }}
{{ end -}}
{{ end -}}
{{ if eq .device_type "work" -}}
{{ range .packages.work_brews -}}
brew {{ . | quote }}
{{ end -}}
{{ end -}}
EOF
)

if ! echo "$BREWFILE" | brew bundle --file=/dev/stdin; then
    echo "brew bundle failed, identifying missing packages..."
    MISSING_PACKAGES=$(echo "$BREWFILE" | brew bundle check --file=/dev/stdin --verbose | grep "The following .* are not installed:" -A 1000 | grep -v "The following .* are not installed:" || true)
    
    if [[ -n "$MISSING_PACKAGES" ]]; then
        echo "Attempting to install missing packages individually..."
        while IFS= read -r package; do
            [[ -z "$package" ]] && continue
            package=$(echo "$package" | xargs) # trim whitespace
            echo "Installing: $package"
            # We need to determine if it's a brew, cask or tap for the individual install command
            # but brew bundle is smarter, so we can just use it for the individual line
            # However, the output of 'brew bundle check --verbose' is just names.
            # Let's use a simpler approach: if it's missing, find the line in BREWFILE that contains it.
            line=$(grep -E "^(brew|cask|tap) \"$package\"" <<< "$BREWFILE" || grep -E "^(brew|cask|tap) '$package'" <<< "$BREWFILE" || true)
            if [[ -n "$line" ]]; then
                if ! echo "$line" | brew bundle --file=/dev/stdin; then
                    echo "FAILED: $line"
                fi
            else
                echo "Could not find Brewfile line for $package, trying 'brew install $package'"
                brew install "$package" || echo "FAILED: brew install $package"
            fi
        done <<< "$MISSING_PACKAGES"
    fi
fi
{{ end -}}
