{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

set -euo pipefail

if ! command -v brew &>/dev/null; then
    echo "brew not found, skipping brews"
    exit 0
fi

brew bundle --file=/dev/stdin <<EOF
{{ range .packages.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ if eq .device_type "personal" -}}
{{ range .packages.personal_brews -}}
brew {{ . | quote }}
{{ end -}}
{{ end -}}
{{ if eq .device_type "work" -}}
{{ range .packages.work_brews -}}
brew {{ . | quote }}
{{ end -}}
{{ end -}}
EOF
{{ end -}}
