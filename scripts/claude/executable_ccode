#!/usr/bin/env bash

set -euo pipefail

choose() {
  fzf --height=40% --layout=reverse --border --prompt="$1" --query="$fzf_query" --exit-0
}

if (($# > 1)); then
  echo "Usage: $(basename "$0") [fzf-query]" >&2
  exit 2
fi
fzf_query="${1:-}"

selection="$(printf '%s\n' \
  $'sonnet\tlow' \
  $'sonnet\tmedium' \
  $'sonnet\thigh' \
  $'sonnet\txhigh' \
  $'sonnet\tmax' \
  $'opus\tlow' \
  $'opus\tmedium' \
  $'opus\thigh' \
  $'opus\txhigh' \
  $'opus\tmax' \
  | choose 'Claude model + effort > ')"
[[ -n "$selection" ]] || exit 0

IFS=$'\t' read -r model effort <<< "$selection"

exec claude --model "$model" --effort "$effort"
