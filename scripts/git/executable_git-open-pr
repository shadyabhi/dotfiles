#!/usr/bin/env bash
# git open-pr — open a browser to raise a PR from the fork's current branch
# back to origin's default branch (cross-fork compare URL).
set -euo pipefail

source "$(dirname "$0")/_fork_lib.sh"

branch=$(git symbolic-ref --short HEAD)
case "$branch" in
    main|master)
        echo "ERROR: refusing to open PR from '$branch'" >&2
        exit 1
        ;;
esac

ensure_fork
default=$(default_branch)

origin_url=$(git remote get-url origin)
fork_url=$(git remote get-url "$fork_remote")

# https://host/owner/repo(.git)? → host, owner/repo
parse() { echo "$1" | sed -E 's#/+$##; s#\.git$##; s#^[^:]+://([^/]+)/(.+)$#\1 \2#'; }
read -r host origin_slug < <(parse "$origin_url")
read -r _    fork_slug   < <(parse "$fork_url")
fork_owner=${fork_slug%%/*}

url="https://${host}/${origin_slug}/compare/${default}...${fork_owner}:${branch}?expand=1"
echo "$url"
open "$url"
