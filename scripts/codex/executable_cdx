#!/usr/bin/env bash

set -euo pipefail

choose() {
  fzf --height=40% --layout=reverse --border --prompt="$1" --query="$fzf_query" --exit-0
}
if (($# > 1)); then
  echo "Usage: $(basename "$0") [fzf-query]" >&2
  exit 2
fi
fzf_query="${1:-}"

selection="$({
  jq -r '
    .models[]
    | select(.visibility == "list")
    | .slug as $model
    | .supported_reasoning_levels[]?.effort
    | [$model, .]
    | @tsv
  ' "$HOME/.codex/models_cache.json"
} | choose 'Codex model + effort > ')"
[[ -n "$selection" ]] || exit 0

IFS=$'\t' read -r model effort _ <<< "$selection"

exec codex --model "$model" --config "model_reasoning_effort=$effort"
