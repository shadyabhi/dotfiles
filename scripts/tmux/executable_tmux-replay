#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.10"
# dependencies = ["pyyaml"]
# ///
"""tmux-replay: build a tmux window of titled panes from a YAML config.

Config format:
    row1:
      title1: cmd
      title2: cmd
    row2:
      title3: cmd

Rows whose name starts with "_" are prep rows: their commands run
sequentially in the foreground, in config order, before any pane is
built. Use them for setup that must finish (and succeed) before the
real panes start, e.g.:
    _1_prepare:
      cmd1: foo
    _2_prepare2:
      cmd2: bar
    main:
      left: bash
      right: bash

Rows are sized equally within the window, panes equally within their row.
"""
import argparse
import os
import shlex
import shutil
import subprocess
import sys
from typing import Any, NoReturn, cast

import yaml

Pane = tuple[str, str]
Row = tuple[str, list[Pane]]


def die(msg: str, code: int = 1) -> NoReturn:
    print(f"tmux-replay: {msg}", file=sys.stderr)
    sys.exit(code)


def tmux(*args: str, capture: bool = False) -> str:
    try:
        r = subprocess.run(
            ["tmux", *args],
            check=True,
            text=True,
            stdout=subprocess.PIPE if capture else None,
            stderr=subprocess.PIPE if capture else None,
        )
    except FileNotFoundError:
        die("tmux not found in PATH")
    except subprocess.CalledProcessError as e:
        die(f"tmux {' '.join(args)} failed: {(e.stderr or '').strip()}")
    return r.stdout.strip() if capture else ""


def load_config(path: str) -> list[Row]:
    """Returns [(row_name, [(title, cmd), ...]), ...] in config order."""
    try:
        loaded: Any = yaml.safe_load(open(path).read())
    except OSError as e:
        die(f"cannot read {path}: {e}")
    except yaml.YAMLError as e:
        die(f"cannot parse {path}: {e}")
    if not isinstance(loaded, dict) or not loaded:
        die("config must be a non-empty mapping of rows")
    config = cast("dict[Any, Any]", loaded)

    rows: list[Row] = []
    for row_name, panes in config.items():
        if not isinstance(panes, dict) or not panes:
            die(f"row {row_name!r} must be a non-empty mapping of title: cmd")
        row: list[Pane] = []
        for title, cmd in cast("dict[Any, Any]", panes).items():
            if not isinstance(cmd, str):
                die(f"{row_name}.{title}: cmd must be a string")
            row.append((str(title), cmd))
        rows.append((str(row_name), row))
    return rows


def filter_rows(rows: list[Row], only: str | None) -> list[Row]:
    if only is None:
        return rows
    row_name, sep, title_name = only.partition(":")
    for name, panes in rows:
        if name != row_name:
            continue
        if not sep:
            return [(name, panes)]
        for pane in panes:
            if pane[0] == title_name:
                return [(name, [pane])]
        die(f"--only {only!r}: no pane titled {title_name!r} in row {row_name!r}")
    die(f"--only {only!r}: no row {row_name!r} in config")


def full_cmd(cmd: str, env: dict[str, str]) -> str:
    """The exact command line a pane runs, POSIX env-var prefix included.

    Setting vars this way (rather than `export ...;` inside the shell) lets
    the shell substitute $VAR / ${VAR} natively at runtime for the whole
    `sh -c` process, with no separate simulation step needed.
    """
    prefix = "".join(f"{k}={shlex.quote(v)} " for k, v in env.items())
    return f"{prefix}{cmd}"


def wrap_cmd(cmd: str, env: dict[str, str]) -> str:
    """Pane command: announce it, run it, then hold the pane open on exit."""
    inner = (
        f"echo {shlex.quote(f'Starting cmd: {full_cmd(cmd, env)}')}; {cmd}; status=$?; "
        f'printf "\\n[exited %s] press enter to close..." "$status"; '
        f"read _"
    )
    return full_cmd(f"sh -c {shlex.quote(inner)}", env)


def existing_names(base: str, kind: str) -> list[str]:
    """Existing base-N names, from N=0 up to the first free index."""
    if kind == "session":
        def taken(name: str) -> bool:
            return subprocess.run(
                ["tmux", "has-session", "-t", name],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            ).returncode == 0
    else:
        windows = set(tmux("list-windows", "-F", "#W", capture=True).splitlines())

        def taken(name: str) -> bool:
            return name in windows

    names: list[str] = []
    while taken(f"{base}-{len(names)}"):
        names.append(f"{base}-{len(names)}")
    return names


def spawn(tmux_args: list[str], title: str, cmd: str, env: dict[str, str],
          parts_left: int = 1) -> str:
    """Runs a pane-creating tmux command, titles the new pane, returns its id.

    parts_left is how many equal panes still have to fit inside the target
    pane, counting the target itself. The new pane takes all but one of them,
    so splitting the newest pane each time leaves every pane the same size.
    """
    size = ["-l", f"{round(100 * (parts_left - 1) / parts_left)}%"] if parts_left > 1 else []
    pane_id = tmux(*tmux_args, *size, "-P", "-F", "#{pane_id}",
                   wrap_cmd(cmd, env), capture=True)
    tmux("select-pane", "-t", pane_id, "-T", title)
    return pane_id


def start_caffeinate(session: str, window_name: str | None) -> None:
    """Run `caffeinate -d` while the target window/session exists (macOS only)."""
    if sys.platform != "darwin" or not shutil.which("caffeinate"):
        return
    if window_name:
        cond = (
            f"tmux list-windows -t {shlex.quote(session)} -F '#W' 2>/dev/null "
            f"| grep -qxF {shlex.quote(window_name)}"
        )
    else:
        cond = f"tmux has-session -t {shlex.quote(session)} 2>/dev/null"
    # `caffeinate -w $$` exits when this watcher shell exits, even on SIGKILL,
    # so caffeinate cannot be orphaned.
    subprocess.Popen(
        ["sh", "-c", f"caffeinate -d -w $$ & while {cond}; do sleep 5; done"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def run_prep(rows: list[Row], env: dict[str, str]) -> None:
    """Run prep-row commands sequentially in the foreground; abort on failure."""
    for row_name, panes in rows:
        for title, cmd in panes:
            full = full_cmd(cmd, env)
            print(f"tmux-replay: [prep {row_name}:{title}] {full}", file=sys.stderr)
            code = subprocess.run(["sh", "-c", full]).returncode
            if code != 0:
                die(f"prep step {row_name}:{title} failed (exit {code})")


def confirm_or_abort() -> None:
    try:
        reply = input("tmux-replay: proceed? [y/N] ")
    except EOFError:
        die("aborted (no input available to confirm)")
    if reply.strip().lower() not in ("y", "yes"):
        die("aborted by user")


def main() -> None:
    p = argparse.ArgumentParser(
        prog="tmux-replay",
        description="Build a tmux window of titled panes from a YAML config.",
    )
    p.add_argument("-n", "--name", default=None,
                   help="window/session name (default: config filename stem)")
    p.add_argument("-N", "--new-session", action="store_true",
                   help="force a new tmux session even when inside tmux")
    p.add_argument("-y", "--yes", action="store_true",
                   help="skip the confirmation prompt and run immediately")
    p.add_argument("--warn-existing", action=argparse.BooleanOptionalAction,
                   default=True,
                   help="warn if a window/session with the base name already exists "
                        "(default: on; use --no-warn-existing to disable)")
    p.add_argument("--only", default=None, metavar="ROW[:TITLE]",
                   help="only build panes from row ROW, or just the pane titled "
                        "TITLE within it; prep rows are skipped unless selected")
    p.add_argument("config", help="path to YAML config file")
    p.add_argument("env", nargs="*",
                   help="env vars to export to pane commands, as key=val")
    args = p.parse_args()

    env: dict[str, str] = {}
    for kv in args.env:
        key, sep, val = kv.partition("=")
        if not sep:
            die(f"invalid env arg {kv!r}: expected key=val")
        env[key] = val

    rows = filter_rows(load_config(args.config), args.only)
    prep_rows = [r for r in rows if r[0].startswith("_")]
    rows = [r for r in rows if not r[0].startswith("_")]
    if not rows:
        die("no panes to build: all rows are prep rows (starting with '_')")

    print("tmux-replay: commands to run:", file=sys.stderr)
    for row_name, panes in prep_rows + rows:
        label = "prep " if row_name.startswith("_") else ""
        for title, cmd in panes:
            print(f"  [{label}{row_name}:{title}] {full_cmd(cmd, env)}", file=sys.stderr)
    if not args.yes:
        confirm_or_abort()
    run_prep(prep_rows, env)

    name = args.name or os.path.splitext(os.path.basename(args.config))[0] or "replay"
    inside_tmux = bool(os.environ.get("TMUX"))
    use_window = inside_tmux and not args.new_session
    kind = "window" if use_window else "session"
    clashes = existing_names(name, kind)
    if clashes and args.warn_existing:
        print(f"tmux-replay: warning: existing {kind}(s) with base {name!r}: "
              f"{', '.join(clashes)}", file=sys.stderr)
    unique = f"{name}-{len(clashes)}"

    if use_window:
        session, window = tmux("display-message", "-p", "#S", capture=True), unique
        create = ["new-window", "-d", "-n", window]
        target_window = f"{session}:{window}"
    else:
        session, window = unique, None
        create = ["new-session", "-d", "-s", session]
        target_window = f"{session}:"

    first_title, first_cmd = rows[0][1][0]
    first_pane = spawn(create, first_title, first_cmd, env)

    # Pane title display on the target window.
    tmux("set-window-option", "-t", target_window, "pane-border-status", "top")
    tmux("set-window-option", "-t", target_window,
         "pane-border-format", "#{pane_title}")
    tmux("set-window-option", "-t", target_window, "synchronize-panes", "off")

    # Build row spines first (vertical splits off the newest spine pane), then
    # horizontal fills within each row off that row's newest pane.
    spine_ids: list[str] = [first_pane]
    for i in range(1, len(rows)):
        title, cmd = rows[i][1][0]
        spine_ids.append(spawn(["split-window", "-v", "-t", spine_ids[-1]],
                               title, cmd, env, parts_left=len(rows) - i + 1))

    for spine_id, (_, panes) in zip(spine_ids, rows):
        anchor = spine_id
        for i, (title, cmd) in enumerate(panes[1:], 1):
            anchor = spawn(["split-window", "-h", "-t", anchor], title, cmd, env,
                           parts_left=len(panes) - i + 1)

    start_caffeinate(session, window)

    # Tail: focus / attach.
    if use_window:
        tmux("select-window", "-t", target_window)
    elif inside_tmux:
        tmux("switch-client", "-t", session)
    else:
        os.execvp("tmux", ["tmux", "attach-session", "-t", session])


if __name__ == "__main__":
    main()
